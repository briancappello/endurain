# Local bare-metal Endurain env. Copy to local/.env and fill in secrets.
# Loaded by run.sh. Mirrors homelab's env.j2 but for localhost + http (no proxy).

# --- Database (local Postgres already running on localhost) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=endurain
DB_DATABASE=endurain
# Must match the password set by setup-db.sh
DB_PASSWORD=changeme-local

# --- Secrets (REQUIRED) ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme

# --- Directories (point at the local build output) ---
# These are filled in automatically by run.sh based on local/build/, but you
# can override them here if you want.
# BACKEND_DIR=
# FRONTEND_DIR=
# DATA_DIR=
# LOGS_DIR=

# --- App config (local dev) ---
ENDURAIN_HOST=http://localhost:8080
BEHIND_PROXY=false
TZ=America/New_York
ENVIRONMENT=development
LOG_LEVEL=info
FRONTEND_PROTOCOL=http

# --- Reverse geocoding (public services for local dev) ---
REVERSE_GEO_PROVIDER=nominatim
NOMINATIM_API_HOST=nominatim.openstreetmap.org
NOMINATIM_API_USE_HTTPS=true
PHOTON_API_HOST=photon.komoot.io
PHOTON_API_USE_HTTPS=true
REVERSE_GEO_RATE_LIMIT=1

# --- Custom fork settings ---
# Keep upstream sync OFF for local dev (no Strava/Garmin polling).
ENDURAIN_UPSTREAM_SYNC=false
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
